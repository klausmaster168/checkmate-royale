<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure-C# Battle Director. References ChessCore only. Zero Unity. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Director</AssemblyName>
    <RootNamespace>CheckmateRoyale.Director</RootNamespace>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Director/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ChessCore/ChessCore.csproj" />
  </ItemGroup>

</Project>
